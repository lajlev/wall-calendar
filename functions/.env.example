# Copy to functions/.env before deploying.
# OAuth client from Google Cloud Console (type: Web application)
GOOGLE_CLIENT_ID=

# The URL the board is opened on. The redirect URI in Google Cloud must be BASE_URL + /auth/callback
BASE_URL=https://<your-project>.web.app

# GOOGLE_CLIENT_SECRET is a secret and is set with:
#   firebase functions:secrets:set GOOGLE_CLIENT_SECRET

# Only these IPs/CIDR ranges may use the board (comma-separated). Empty = no restriction.
# Add your home IPv6 prefix too if your provider enables IPv6, e.g. 203.0.113.10, 2001:db8::/64
ALLOWED_IPS=
